# ClaimBack backend environment sample
# Copy this file to backend/.env and replace the placeholders with your own local values.
# Keep backend/.env out of version control and never commit real AWS credentials.

# Runtime
ENVIRONMENT=development
AWS_REGION=us-east-1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Core backend selection
REPOSITORY_BACKEND=dynamodb
EXTRACTION_BACKEND=llm
OCR_BACKEND=textract
SUBMISSION_BACKEND=ses

# Model configuration
# Use either OpenAI-compatible settings or Bedrock-native settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PROJECT_ID=
OPENAI_MODEL_ID=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# AWS
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DYNAMODB_TABLE_NAME=ClaimBackSingleTable
DYNAMODB_ENDPOINT_URL=

# S3 buckets
# Bucket names must be globally unique. Replace the placeholder suffix with your own value.
S3_VAULT_BUCKET=claimback-vault-demo
CLAIMBACK_RAW_DOCUMENTS_BUCKET=claimback-raw-documents-demo
CLAIMBACK_GENERATED_ARTIFACTS_BUCKET=claimback-generated-artifacts-demo

# OCR / SES
TEXTRACT_ROLE_ARN=
SES_FROM_EMAIL=verified-sender@example.com
SES_REPLY_TO_EMAIL=ops@example.com
SUBMISSION_RECIPIENT_OVERRIDE=

# Optional API deployment values
# API_STAGE=dev
